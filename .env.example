# ── 应用 ──────────────────────────────────────────────
# 复制为 .env 后按需修改；scripts/dev.sh 会导出到进程环境
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
WEB_ORIGIN=http://localhost:5173

# ── 数据库（SQLite，单文件）────────────────────────────
# 相对路径会被 scripts/dev.* 归一化为「仓库根/data/panel-studio.db」——spring-boot:run 会把
# JVM 工作目录切到 server/，不归一化就会在 server/data 下另起一个库，导致「删了库数据还在」。
# 直接用 java -jar 运行时，请在仓库根执行，或把这里改成绝对路径。
SQLITE_PATH=./data/panel-studio.db

# ── LLM（OpenAI 兼容接口）──────────────────────────────
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=your-model-name

# ── 调度与并发（JDK 17 无虚拟线程，必须显式配置）───────
MAX_CONCURRENT_AGENTS_PER_ROOM=3
MAX_CONCURRENT_AGENTS_GLOBAL=20
AGENT_EXECUTOR_CORE=8
AGENT_EXECUTOR_MAX=16
AGENT_EXECUTOR_QUEUE=200
TURN_SPEAKER_LIMIT=3
DISCUSSION_TOKEN_BUDGET=120000
SPEAKER_MAX_CHARS=180

# ── 超时 ──────────────────────────────────────────────
LLM_TIMEOUT_FIRST_TOKEN_MS=45000
LLM_TIMEOUT_TOTAL_MS=90000
SSE_HEARTBEAT_MS=15000

# ── 测试（E2E/集成指向 WireMock，非容器）───────────────
LLM_MOCK_BASE_URL=http://127.0.0.1:9100/v1
